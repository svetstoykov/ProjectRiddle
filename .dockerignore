**/obj/
**/node_modules/
**/dist/
src/ProjectRiddle.Api/wwwroot/
*.db
*.db-shm
*.db-wal

.git/
.gitignore
docs/
mockups/
tests/
.vs/
.idea/
.vscode/
.DS_Store
.deploy.env
